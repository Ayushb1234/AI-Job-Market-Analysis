*.secret

# Data files should not be committed unless they are small, public,
# and intentionally versioned. Keep raw/source datasets local.
data/raw/
data/external/
data/final/

# Processed archives may be versioned intentionally; extracted tables stay local.
data/processed/*.csv
data/processed/*.xlsx
data/processed/*.xls
data/processed/*.jsonl
data/processed/*.parquet
data/processed/*.feather
data/processed/*.pkl
data/processed/*.pickle

*.csv
*.xlsx
*.xls
*.jsonl
*.parquet
*.feather
*.pkl
*.pickle

# Generated analysis outputs
reports/
dashboards/exports/
*.html
*.pdf

# Logs and runtime artifacts
logs/
*.log
tmp/
temp/

# OS and editor files
.DS_Store
Thumbs.db
desktop.ini
